---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
import { useDict } from '../i18n';
import { serviciosJsonLd } from '../lib/schema';

const lang = 'es' as const;
const t = useDict(lang);
---
<Layout lang={lang} title={t.meta.title} description={t.meta.description} path="/"
        jsonld={serviciosJsonLd(lang)}>
  <Home lang={lang} />
</Layout>
