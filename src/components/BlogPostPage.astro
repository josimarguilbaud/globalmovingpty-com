---
/**
 * Un artículo del blog.
 *
 * Sin foto de cabecera a propósito. Las tres fotos que tiene la web son de
 * banco de imágenes y ninguna ilustra «qué voltaje usa Panamá» ni «cómo se
 * reserva el ascensor de un PH». Poner una foto bonita que no tiene que ver
 * con el texto es relleno, y encima empuja el contenido bajo el pliegue. La
 * cabecera es tipográfica hasta que haya fotos propias.
 */
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { langUrl, SITE_URL, type Locale } from '../lib/site';
import { useDict, useServicio } from '../i18n';
import { breadcrumbJsonLd } from '../lib/schema';
import { render, type CollectionEntry } from 'astro:content';

interface Props { lang: Locale; entrada: CollectionEntry<'blog'>; relacionados: CollectionEntry<'blog'>[] }
const { lang, entrada, relacionados } = Astro.props;
const t = useDict(lang);
const d = entrada.data;
const slug = entrada.id.split('/').slice(1).join('/');
const ruta = `/blog/${slug}`;
const { Content } = await render(entrada);

// La ficha de servicio con la que se relaciona. `useServicio` lanza si el slug
// no existe, así que un enlace muerto rompe el build en vez de publicarse.
const servicio = useServicio(lang, d.servicio);

const fecha = d.date.toISOString().slice(0, 10);
const fechaLegible = d.date.toLocaleDateString(lang === 'es' ? 'es-PA' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: d.title,
      description: d.description,
      datePublished: fecha,
      dateModified: fecha,
      inLanguage: lang,
      author: { '@id': `${SITE_URL}/#negocio` },
      publisher: { '@id': `${SITE_URL}/#negocio` },
      mainEntityOfPage: `${SITE_URL}${langUrl(lang, ruta)}`,
      about: { '@type': 'Service', name: servicio.titulo },
    },
    breadcrumbJsonLd(lang, [
      { nombre: t.serviciosPage.migaInicio, path: '/' },
      { nombre: t.nav.blog, path: '/blog' },
      { nombre: d.title, path: ruta },
    ]),
  ],
};
---
<Layout lang={lang} title={`${d.title} | ${t.blog.marca}`} description={d.description}
        path={ruta} jsonld={jsonld}>
  <Nav lang={lang} />

  <article>
    <header class="bg-primary-900 text-white py-16 md:py-20">
      <div class="container mx-auto px-4 max-w-3xl">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-primary-200">
          <ol class="flex flex-wrap items-center gap-2 list-none p-0">
            <li><a href={langUrl(lang, '/')} class="hover:text-white transition">{t.serviciosPage.migaInicio}</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={langUrl(lang, '/blog')} class="hover:text-white transition">{t.nav.blog}</a></li>
          </ol>
        </nav>
        <div class="flex flex-wrap items-center gap-3 mb-5 text-sm">
          <span class="bg-primary-700 text-primary-100 py-1 px-3 rounded-full font-semibold">{d.category}</span>
          <span class="text-primary-200">{t.blog.lectura.replace('{n}', String(d.minutes))}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-5">{d.title}</h1>
        <p class="text-lg text-gray-200 leading-relaxed mb-5">{d.description}</p>
        <time datetime={fecha} class="text-sm text-primary-200">{fechaLegible}</time>
      </div>
    </header>

    <div class="py-16 md:py-20 bg-white">
      <div class="container mx-auto px-4 max-w-3xl">
        {/* `prosa` vive en global.css: el markdown no lleva clases de Tailwind. */}
        <div class="prosa">
          <Content />
        </div>

        {/* El puente del artículo al servicio. Sin esto el blog no vende. */}
        <aside class="mt-14 bg-gray-50 border border-gray-100 rounded-2xl p-8">
          <p class="text-sm font-semibold text-primary-700 uppercase tracking-wider mb-3">{t.blog.servicioRelacionado}</p>
          <a href={langUrl(lang, `/servicios/${servicio.slug}`)} class="group flex items-start gap-4">
            <span class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors">
              <Icon name={servicio.icono} class="w-6 h-6" />
            </span>
            <span>
              <span class="block text-lg font-bold text-gray-900 group-hover:text-primary-700 transition-colors">{servicio.titulo}</span>
              <span class="block text-gray-600 leading-relaxed mt-1">{servicio.entradilla}</span>
            </span>
          </a>
        </aside>

        {relacionados.length > 0 && (
          <section class="mt-14">
            <h2 class="text-xl font-bold text-gray-900 mb-6">{t.blog.masArticulos}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relacionados.map((r) => (
                <a href={langUrl(lang, `/blog/${r.id.split('/').slice(1).join('/')}`)}
                   class="block p-5 rounded-xl border border-gray-200 hover:border-primary-300 hover:bg-primary-50 transition group">
                  <span class="block text-xs font-semibold text-primary-600 uppercase tracking-wider mb-2">{r.data.category}</span>
                  <span class="block font-bold text-gray-900 group-hover:text-primary-700 transition-colors">{r.data.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <a href={langUrl(lang, '/blog')} class="inline-flex items-center gap-2 mt-10 text-primary-600 font-semibold hover:text-primary-700 transition">
          <Icon name="arrow" class="w-4 h-4 rotate-180" /> {t.blog.volver}
        </a>
      </div>
    </div>
  </article>

  <Footer lang={lang} />
</Layout>
