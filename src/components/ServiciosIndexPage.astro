---
/**
 * El índice `/servicios`.
 *
 * Existe por dos razones, y ninguna es decorativa:
 *
 * 1. El «Servicios» de la cabecera tiene que llevar a algún sitio. Un menú
 *    desplegable cuyo padre no navega deja el catálogo inalcanzable para quien
 *    no puede o no quiere desplegarlo.
 * 2. Es el nodo que reparte enlaces hacia las nueve fichas. Sin él, cada ficha
 *    cuelga solo de la portada y del pie.
 *
 * Los textos de las tarjetas son `resumen`, los mismos que en la portada. Es a
 * propósito: son dos vistas del mismo catálogo, no dos contenidos distintos, y
 * escribir un segundo texto para decir lo mismo es justo lo que crea páginas
 * que compiten entre sí.
 */
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { langUrl, SITE_URL, type Locale } from '../lib/site';
import { useDict, useServicios } from '../i18n';
import { breadcrumbJsonLd } from '../lib/schema';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useDict(lang);
const servicios = useServicios(lang);

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      name: t.serviciosPage.h1,
      itemListElement: servicios.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.titulo,
        url: `${SITE_URL}${langUrl(lang, `/servicios/${s.slug}`)}`,
      })),
    },
    breadcrumbJsonLd(lang, [
      { nombre: t.serviciosPage.migaInicio, path: '/' },
      { nombre: t.nav.servicios, path: '/servicios' },
    ]),
  ],
};
---
<Layout lang={lang} title={t.serviciosPage.metaTitle} description={t.serviciosPage.metaDescription}
        path="/servicios" jsonld={jsonld}>
  <Nav lang={lang} />

  <header class="bg-primary-900 text-white py-16 md:py-20">
    <div class="container mx-auto px-4 max-w-4xl">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-primary-200">
        <ol class="flex flex-wrap items-center gap-2 list-none p-0">
          <li><a href={langUrl(lang, '/')} class="hover:text-white transition">{t.serviciosPage.migaInicio}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white font-medium" aria-current="page">{t.nav.servicios}</li>
        </ol>
      </nav>
      <div class="inline-block py-1 px-3 rounded-full bg-primary-700 text-primary-100 text-sm font-semibold tracking-wider mb-4">
        {t.serviciosPage.eyebrow}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight mb-4">{t.serviciosPage.h1}</h1>
      <p class="text-lg text-gray-200 leading-relaxed">{t.serviciosPage.lead}</p>
    </div>
  </header>

  <section class="py-16 md:py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {servicios.map((s) => (
          <article class="bg-white border border-gray-100 rounded-2xl shadow-lg hover:shadow-2xl transition-shadow duration-300 group flex">
            <a href={langUrl(lang, `/servicios/${s.slug}`)} class="p-8 flex flex-col h-full">
              <div class="w-14 h-14 bg-primary-50 rounded-xl flex items-center justify-center text-primary-600 mb-6 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-300">
                <Icon name={s.icono} class="w-7 h-7" />
              </div>
              <h2 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-primary-700 transition-colors">{s.titulo}</h2>
              <p class="text-gray-600 leading-relaxed mb-5">{s.resumen}</p>
              <span class="mt-auto inline-flex items-center gap-2 text-primary-600 font-semibold text-sm">
                {t.serviciosPage.verFicha} <Icon name="arrow" class="w-4 h-4" />
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />
</Layout>
