/**
 * Los iconos, en SVG inline.
 *
 * La plantilla cargaba Font Awesome por CDN en su versión JavaScript
 * (`all.min.js`, ~500 KB) para dibujar quince iconos. Eso es más peso que el
 * resto de la página entera, bloquea el render y añade una dependencia de un
 * tercero que puede caerse. Aquí cada icono son unos 200 bytes de SVG que van
 * en el HTML y se pintan aunque no haya JS.
 *
 * Trazos de Lucide (ISC), que es lo mismo que usa Font Awesome en su versión
 * de línea pero sin el runtime.
 */
interface Props {
  name: string;
  class?: string;
  filled?: boolean;
}
const { name, class: cls = 'w-6 h-6', filled = false } = Astro.props;

